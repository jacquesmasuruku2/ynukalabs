# Ynuka Labs — Public Website (racine public_html)
# À copier vers : domains/ynukalabs.com/public_html/.htaccess

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Laisser intact le backend PHP sous /php/ (api.php, config.php, etc.)
  RewriteRule ^php(/|$) - [L,NC]

  # 2) Ne pas réécrire les fichiers et dossiers qui existent réellement
  #    (assets/, index.html, favicon, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Routes virtuelles React (/events, /resources, …) → SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Page d'accueil par défaut
DirectoryIndex index.html

# Pas de listing de répertoires
Options -Indexes

# (CORS « * » supprimée : l'API PHP gère elle-même ses origines autorisées)
# ============ EN-TÊTES DE SÉCURITÉ ============
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header unset X-Powered-By
</IfModule>

# Fichiers sensibles jamais servis
<FilesMatch "(^\.|\.(env|sql|md|log|sh|ps1|bak|zip)$|^(config|database|google-oauth)\.php$)">
  Require all denied
</FilesMatch>

