{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/luma-api/:path*",
      "destination": "https://api.luma.com/:path*"
    },
    {
      "source": "/((?!luma-api/).*)",
      "destination": "/index.html"
    }
  ]
}
