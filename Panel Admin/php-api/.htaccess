# Pass Authorization header to PHP (Interserver / DirectAdmin)
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Google OAuth (lu par api.php via getenv — optionnel si déjà dans api.php)
SetEnv GOOGLE_CLIENT_ID "1039734035041-3ob85lpfheoonvv43759desitdr7rhgc.apps.googleusercontent.com"
SetEnv GOOGLE_CLIENT_SECRET "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"
SetEnv GOOGLE_REDIRECT_URI "https://admin.ynukalabs.com/api/api.php?action=google_callback"
SetEnv PANEL_URL "https://admin.ynukalabs.com"
# Tout compte Google vérifié peut se connecter (défaut). Pour restreindre : false + admin_allowed_emails
SetEnv GOOGLE_OPEN_ACCESS "true"
