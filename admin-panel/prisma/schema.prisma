generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Category {
  id            String                @id @default(cuid())
  title         String
  slug          String                @unique
  description   String?
  color         String?
  icon          String?
  defaultLocale String                @default("fr")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  articles      Article[]
  media         Media[]
  liveEvents    LiveEvent[]
  translations  CategoryTranslation[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
}

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio       String?
  role      String?
  email     String?
  imageUrl  String?
  imageAlt  String?
  articles  Article[]
  media     Media[]
  blogPosts BlogPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  role         String
  description  String?
  imageUrl     String?
  imageAlt     String?
  xUrl         String?
  linkedinUrl  String?
  telegramUrl  String?
  portfolioUrl String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  legacyId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([name])
  @@index([legacyId])
}

model ResourceSection {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  displayOrder Int          @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ResourceItem[]

  @@index([isActive])
  @@index([displayOrder])
}

model ResourceItem {
  id          String         @id @default(cuid())
  sectionId   String?
  section     ResourceSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title       String
  titleFr     String?
  description String?
  descriptionFr String?
  category    String?
  url         String?
  filePath    String?
  fileType    String?
  iconKey     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sectionId])
  @@index([category])
}

model Article {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  excerpt           String
  content           Json
  categoryId        String
  authorId          String?
  publishedAt       DateTime
  mainImageUrl      String?
  externalLink      String?
  mainImageAlt      String?
  additionalImages  Json?              @default("[]")
  additionalImageDescriptions Json?    @default("[]")
  readTime          String?
  featured          Boolean            @default(false)
  isPremium         Boolean            @default(false)
  premiumPrice      Decimal?           @db.Decimal(10, 2)
  views             BigInt             @default(0)
  defaultLocale     String             @default("fr")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  author            Author?            @relation(fields: [authorId], references: [id])
  category          Category           @relation(fields: [categoryId], references: [id])
  comments          Comment[]
  publicComments    BlogComment[]
  likes             Like[]
  translations      ArticleTranslation[]
  sponsoredArticles SponsoredArticle[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([isPremium])
  @@index([views(sort: Desc)])
}

model SponsoredArticle {
  id            String   @id @default(cuid())
  articleId     String?
  title         String
  imageUrl      String
  targetUrl     String
  sponsorName   String
  categoryBadge String   @default("Publicité")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  article       Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([isActive])
  @@index([sortOrder])
}

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  locale    String
  title     String
  excerpt   String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([articleId])
  @@index([locale])
}

model AdminUser {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  provider      String        @default("email")
  googleId      String?       @unique
  role          String        @default("admin")
  isActive      Boolean       @default(true)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?
  sessions      AdminSession[]
  passwordResets AdminPasswordReset[]
  invitesSent   AdminInvite[] @relation("AdminInvitesSent")
  invite        AdminInvite? @relation("AdminInviteTarget")
  updatedSettings AdminSettings[] @relation("AdminSettingsUpdatedBy")
  contentOwnerships AdminContentOwnership[]

  @@index([email])
  @@index([provider])
}

model AdminSettings {
  id                   String    @id @default("global")
  siteName             String    @default("Ynuka Labs")
  contactEmail         String    @default("contact@ynukalabs.com")
  emailNotifications   Boolean   @default(true)
  securityAlerts       Boolean   @default(true)
  weeklyReports        Boolean   @default(false)
  publicApiKey         String    @unique
  updatedAt            DateTime  @updatedAt
  updatedById          String?
  updatedBy            AdminUser? @relation("AdminSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AdminSession {
  id          String     @id @default(cuid())
  adminUserId String
  adminUser   AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  token       String     @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  device      String?
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  @@index([adminUserId])
}

model AdminPasswordReset {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  adminUser  AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  name        String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   AdminUser @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  adminUserId String?   @unique
  adminUser   AdminUser? @relation("AdminInviteTarget", fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
}

model AdminContentOwnership {
  id           String    @id @default(cuid())
  resourceType String
  resourceId   String
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([resourceType, resourceId])
  @@index([adminUserId])
  @@index([resourceType, resourceId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("reader")
  avatarUrl     String?
  bio           String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  sessions      Session[]
  comments      Comment[]
  likes         Like[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentToComment")
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([status])
}

model BlogComment {
  id          String             @id @default(cuid())
  articleId   String
  article     Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  approved    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  replies     BlogCommentReply[]

  @@index([articleId])
  @@index([approved])
}

model BlogCommentReply {
  id          String      @id @default(cuid())
  commentId   String
  comment     BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([commentId])
}

model Like {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}
model ContentReaction {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  userEmail    String
  reactionType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resourceType, resourceId, userEmail])
  @@index([resourceType, resourceId])
  @@index([resourceType, resourceId, reactionType])
}
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model NewsletterSubscription {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  interests      Json?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model RadioStation {
  id          String        @id @default(cuid())
  name        String
  streamUrl   String
  logoUrl     String?
  description String?
  showLabel   Boolean       @default(true)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  programs    RadioProgram[]

  @@index([isActive])
}

model RadioProgram {
  id          String       @id @default(cuid())
  stationId   String?
  title       String
  slug        String       @unique
  host        String?
  description String?
  streamUrl   String?
  imageUrl    String?
  startTime   DateTime
  endTime     DateTime?
  isLive      Boolean      @default(false)
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  station     RadioStation? @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([startTime])
  @@index([isLive])
  @@index([isFeatured])
}

model Media {
  id           String    @id @default(cuid())
  type         String
  title        String
  slug         String    @unique
  description  String?
  url          String
  thumbnailUrl String?
  duration     BigInt?
  categoryId   String?
  authorId     String?
  publishedAt  DateTime
  views        BigInt    @default(0)
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       Author?   @relation(fields: [authorId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([type])
  @@index([categoryId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model Donation {
  id             String    @id @default(cuid())
  donorName      String?
  donorEmail     String?
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("EUR")
  type           String
  status         String    @default("pending")
  message        String?
  isAnonymous    Boolean   @default(false)
  paymentMethod  String?
  transactionId  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Partnership {
  id          String    @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  type        String
  description String?
  imageUrl    String?
  websiteUrl  String?
  status      String    @default("pending")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

model PressRelease {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String
  content      Json
  source       String
  type         String
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model JobOffer {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  requirements String?
  details Json? @default("{}")
  imageUrl String?
  location    String?
  type        String
  salary      String?
  companyId   String?
  publishedAt DateTime
  deadline    DateTime?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  applications JobApplication[]

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([deadline])
}

model JobApplication {
  id         String   @id @default(cuid())
  jobOfferId String
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  coverLetter String?
  resumeUrl  String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      Json
  type         String
  authorId     String?
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  readTime     String?
  featured     Boolean  @default(false)
  views        BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       Author?  @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model LiveEvent {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  thumbnail    String?
  streamUrl    String?
  youtubeUrl   String?
  status       LiveStatus @default(SCHEDULED)
  startTime    DateTime
  endTime      DateTime?
  viewerCount  Int        @default(0)
  isFeatured   Boolean    @default(false)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([isFeatured])
  @@index([categoryId])
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Event {
  id              String              @id @default(cuid())
  title           String
  titleFr         String?
  slug            String?             @unique
  description     String?
  descriptionFr   String?
  date            DateTime?
  startDate       DateTime?
  endDate         DateTime?
  time            String?
  location        String?
  type            String?
  capacity        Int?
  imageUrl        String?
  featuredImage   String?
  recapUrl        String?
  youtubeUrl      String?
  upcoming        Boolean             @default(true)
  published       Boolean             @default(true)
  legacyId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  registrations   EventRegistration[]

  @@index([published])
  @@index([upcoming])
  @@index([date])
  @@index([legacyId])
}

model EventRegistration {
  id           String              @id @default(cuid())
  eventId      String
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String?
  organization String?
  message      String?
  avatarUrl    String?
  googleSub    String?
  status       String              @default("registered")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  conversation EventConversation?

  @@unique([eventId, email])
  @@index([eventId])
  @@index([status])
  @@index([email])
}

model EventConversation {
  id             String             @id @default(cuid())
  registrationId String             @unique
  registration   EventRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       EventMessage[]
}

model EventMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   EventConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String
  senderEmail    String?
  senderName     String?
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@index([readAt])
}

model SiteNotification {
  id        String   @id @default(cuid())
  userEmail String
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userEmail])
  @@index([read])
  @@index([createdAt(sort: Desc)])
}

model SitePresence {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  path       String
  pageTitle  String?
  referrer   String?
  userAgent  String?
  language   String?
  userEmail  String?
  userName   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lastSeenAt(sort: Desc)])
  @@index([path])
  @@index([userEmail])
}

model SitePageView {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  pageTitle String?
  referrer  String?
  userAgent String?
  language  String?
  userEmail String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([path])
  @@index([userEmail])
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String   @default("General")
  description   String?
  status        String   @default("active")
  featuredImage String?
  repositoryUrl String?
  liveUrl       String?
  showOnHome    Boolean  @default(false)
  legacyId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([showOnHome])
  @@index([createdAt(sort: Desc)])
  @@index([legacyId])
}

model Opportunity {
  id               String                       @id @default(cuid())
  title            String
  titleFr          String?
  slug             String                       @unique
  excerpt          String?
  excerptFr        String?
  content          String?
  contentFr        String?
  category         String                       @default("General")
  coverUrl         String?
  published        Boolean                      @default(false)
  legacyId         String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  applications     OpportunityApplication[]
  motivationForms  OpportunityMotivationForm[]

  @@index([published])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([legacyId])
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userEmail     String
  userName      String?
  userAvatar    String?
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
  @@index([status])
}

model OpportunityMotivationForm {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userEmail     String
  userName      String?
  userAvatar    String?
  linkedinUrl   String?
  twitterUrl    String?
  portfolioUrl  String?
  message       String?
  cvFileUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  slug         String?  @unique
  description  String?
  logoUrl      String?
  websiteUrl   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  legacyId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([legacyId])
}

model GalleryEvent {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  date        DateTime?
  description String?
  images      Json      @default("[]")
  legacyId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date(sort: Desc)])
  @@index([legacyId])
}

/// Demandes d'événement envoyées depuis le site (/events#proposer-evenement)
model EventProposal {
  id                  String    @id @default(cuid())
  contactName         String
  contactEmail        String
  contactPhone        String?
  organization        String
  title               String
  description         String
  category            String
  eventDate           DateTime?
  eventTime           String?
  timezone            String?
  format              String
  locationOrLink      String?
  venue               String?
  onlineLink          String?
  audience            String?
  capacity            Int?
  publicationChannel  String    @default("ynuka_agenda")
  externalEventUrl    String?
  registrationMode    String?
  registrationUrl     String?
  imageUrl            String?
  imageData           String?
  imageFilename       String?
  partners            String?
  speakers            String?
  status              String    @default("pending")
  adminNotes          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([contactEmail])
}

