<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Never rewrite files that actually exist
  RewriteCond %{REQUEST_FILENAME} -f [L]
  RewriteRule ^ - [L]
  
  # Never rewrite directories that actually exist
  RewriteCond %{REQUEST_FILENAME} -d [L]
  RewriteRule ^ - [L]
  
  # Explicitly allow /assets/ directory
  RewriteRule ^assets/ - [L]
  
  # Rewrite all other requests to index.html for React Router SPA
  RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>

# Security: prevent directory listing
Options -Indexes

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Caching for static assets
<FilesMatch "\.(js|css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# Don't cache HTML
<FilesMatch "\.html$">
  Header set Cache-Control "max-age=0, public, must-revalidate"
</FilesMatch>
