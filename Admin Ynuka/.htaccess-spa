<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Explicitly allow access to real files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # Explicitly allow access to real directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Rewrite all other requests (including /login, /dashboard, etc.) to index-spa.html
  # This allows React Router to handle all routes client-side
  RewriteRule ^.*$ index-spa.html [L,QSA]
</IfModule>
