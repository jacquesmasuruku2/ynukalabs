{
  "buildCommand": "npm --prefix YnukaSite run build",
  "installCommand": "npm --prefix YnukaSite ci",
  "outputDirectory": "YnukaSite/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/luma-api/:path*",
      "destination": "https://api.luma.com/:path*"
    },
    {
      "source": "/resources",
      "destination": "/index.html"
    },
    {
      "source": "/resources/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!luma-api/).*)",
      "destination": "/index.html"
    }
  ]
}
